#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/input_mock.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &gresc         &none
                &kp LEFT_SHIFT &kp LEFT_GUI
            >;
        };
    };
};

&mock_input {
    events = <
        /* esc */
        ZMK_INPUT_MOCK_PRESS(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(0,0,10)

        /* ~ */
        ZMK_INPUT_MOCK_PRESS(1,0,10)
        ZMK_INPUT_MOCK_PRESS(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(1,0,10)

        /* LGUI+` */
        ZMK_INPUT_MOCK_PRESS(1,1,10)
        ZMK_INPUT_MOCK_PRESS(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(1,1,10)

        /* ~ */
        ZMK_INPUT_MOCK_PRESS(1,0,10)
        ZMK_INPUT_MOCK_PRESS(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(1,0,10)
        ZMK_INPUT_MOCK_RELEASE(0,0,10)

        /* LGUI+` */
        ZMK_INPUT_MOCK_PRESS(1,1,10)
        ZMK_INPUT_MOCK_PRESS(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(1,1,10)
        ZMK_INPUT_MOCK_RELEASE(0,0,10)
    >;
};