#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/input_mock.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &mkp LCLK &none
            &none     &mkp RCLK
            >;
        };
    };
};


&mock_input {
    events = <
    ZMK_INPUT_MOCK_PRESS(0,0,100)
    ZMK_INPUT_MOCK_PRESS(1,1,100)
    ZMK_INPUT_MOCK_RELEASE(1,1, 10)
    ZMK_INPUT_MOCK_RELEASE(0,0, 10)
    >;
};
