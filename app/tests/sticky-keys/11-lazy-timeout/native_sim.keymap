#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/input_mock.h>

/* this test ensures that lazy sticky keys don't emit anything on timeout */

&sk {
    lazy;
    release-after-ms = <50>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &sk LEFT_CONTROL &kp A
                &sk LEFT_SHIFT &sk LEFT_ALT>;
        };
    };
};

&mock_input {
    events = <
        /* tap sk LEFT_CONTROL */
        ZMK_INPUT_MOCK_PRESS(0,0,10)
        ZMK_INPUT_MOCK_RELEASE(0,0,10)
        /* tap sk LEFT_SHIFT */
        ZMK_INPUT_MOCK_PRESS(1,0,10)
        ZMK_INPUT_MOCK_RELEASE(1,0,60)
        /* tap sk LEFT_ALT */
        ZMK_INPUT_MOCK_PRESS(1,1,10)
        ZMK_INPUT_MOCK_RELEASE(1,1,60)
        /* tap A */
        ZMK_INPUT_MOCK_PRESS(0,1,10)
        ZMK_INPUT_MOCK_RELEASE(0,1,10)
        /* tap A */
        ZMK_INPUT_MOCK_PRESS(0,1,10)
        ZMK_INPUT_MOCK_RELEASE(0,1,10)
    >;
};
