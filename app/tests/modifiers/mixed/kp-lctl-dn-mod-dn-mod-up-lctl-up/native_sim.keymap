#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/input_mock.h>


&mock_input {
    events = <
        ZMK_INPUT_MOCK_PRESS(1,0,10)
        ZMK_INPUT_MOCK_PRESS(0,1,10)
        ZMK_INPUT_MOCK_RELEASE(0,1,10)
        ZMK_INPUT_MOCK_RELEASE(1,0,10)
    >;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp LC(A) &kp LS(B)
                &kp LEFT_CONTROL &none
            >;
        };
    };
};
