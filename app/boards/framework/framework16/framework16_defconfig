CONFIG_ZMK_KEYBOARD_NAME="Framework Laptop 16 - Zephyr Keyboard"
CONFIG_USB_DEVICE_MANUFACTURER="Framework Computer"
CONFIG_USB_DEVICE_VID=0x32ac
# PID for non-production inputmodule firmware
CONFIG_USB_DEVICE_PID=0x001F

CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=125000000

# Enable USB CDC ACM logging for debugging
# CONFIG_ZMK_USB_LOGGING=y

# Enable reset by default
CONFIG_RESET=y
CONFIG_CLOCK_CONTROL=y

# Code partition needed to target the correct flash range
CONFIG_USE_DT_CODE_PARTITION=y

# Output UF2 by default, native bootloader supports it.
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_ZMK_USB=y

CONFIG_GPIO=y
CONFIG_PWM=y
CONFIG_LED=y
CONFIG_ZMK_BACKLIGHT=y
CONFIG_SHELL=y
