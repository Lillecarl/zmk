/dts-v1/;

#include <rpi_pico/rp2040.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include "framework16-pinctrl.dtsi"

#include <layouts/common/65percent/ansi.dtsi>

/ {
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &code_partition;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &layout_65_ansi;
        zmk,backlight = &backlight_pwm;
    };

    aliases {
        led0 = &caps_led;
        pwm-led0 = &backlight_pwm;
    };


    leds {
        compatible = "gpio-leds";
        caps_led: led_0 {
            gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        };
    };

    backlight_pwm: pwmleds {
        compatible = "pwm-leds";
        status = "okay";
        pwm_led_0 {
            pwms = <&pwm 9 PWM_NSEC(1000) PWM_POLARITY_NORMAL>;
            label = "Backlight";
        };
    };


    xtal_clk: xtal-clk {
        compatible = "fixed-clock";
        clock-frequency = <12000000>;
        #clock-cells = <0>;
    };


    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <8>;
        /* TODO Map key matrix */
        map = <
          RC(0,0)
        >;
    };

    // Dummy keyscan to make it compile
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-adc";
        wakeup-source;

        adc-gpios
                  = <&gpio0 1 GPIO_ACTIVE_HIGH>
                  , <&gpio0 2 GPIO_ACTIVE_HIGH>
                  , <&gpio0 3 GPIO_ACTIVE_HIGH>
                  ;
        // mux-enable = <&gpio0 4 GPIO_ACTIVE_HIGH>;

        col-gpios
                  = <&gpio0  8 GPIO_ACTIVE_HIGH>  // KSO0
                  , <&gpio0  9 GPIO_ACTIVE_HIGH>  // KSO1
                  , <&gpio0 10 GPIO_ACTIVE_HIGH>  // KSO2
                  , <&gpio0 11 GPIO_ACTIVE_HIGH>  // KSO3
                  , <&gpio0 12 GPIO_ACTIVE_HIGH>  // KSO4
                  , <&gpio0 13 GPIO_ACTIVE_HIGH>  // KSO5
                  , <&gpio0 14 GPIO_ACTIVE_HIGH>  // KSO6
                  , <&gpio0 15 GPIO_ACTIVE_HIGH>  // KSO7
                  , <&gpio0 21 GPIO_ACTIVE_HIGH>  // KSO8
                  , <&gpio0 20 GPIO_ACTIVE_HIGH>  // KSO9
                  , <&gpio0 19 GPIO_ACTIVE_HIGH>  // KSO10
                  , <&gpio0 18 GPIO_ACTIVE_HIGH>  // KSO11
                  , <&gpio0 17 GPIO_ACTIVE_HIGH>  // KSO12
                  , <&gpio0 16 GPIO_ACTIVE_HIGH>  // KSO13
                  , <&gpio0 23 GPIO_ACTIVE_HIGH>  // KSO14
                  , <&gpio0 22 GPIO_ACTIVE_HIGH>  // KSO15
                  ;
    };

    // TODO: Implement analog key scanning with SGM48751 MUX
    // kscan0: kscan {
    //     compatible = "TBD";
    //     mux-enable-gpio = <&gpio0 4 GPIO_ACTIVE_HIGH)>;
    //     row-mux-gpios
    //         = <&gpio0 1 GPIO_ACTIVE_HIGH)>
    //         , <&gpio0 2 GPIO_ACTIVE_HIGH)>
    //         , <&gpio0 3 GPIO_ACTIVE_HIGH)>
    //         ;
    //     col-gpios
    //         = <&gpio0 8  GPIO_ACTIVE_HIGH>
    //         , <&gpio0 9  GPIO_ACTIVE_HIGH>
    //         , <&gpio0 10 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 11 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 12 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 13 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 14 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 15 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 16 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 17 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 18 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 19 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 20 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 21 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 22 GPIO_ACTIVE_HIGH>
    //         , <&gpio0 23 GPIO_ACTIVE_HIGH>
    //         ;
    // };
};

&flash0 {
    reg = <0x10000000 DT_SIZE_M(16)>;

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* Reserved memory for the second stage bootloader */
        second_stage_bootloader: partition@0 {
            reg = <0x00000000 0x100>;
            read-only;
        };

        /*
         * Usable flash. Starts at 0x100, after the bootloader. The partition
         * size is 16MB minus the 0x100 bytes taken by the bootloader.
         */
        code_partition: partition@100 {
            reg = <0x100 (DT_SIZE_M(16) - 0x100)>;
            read-only;
        };
    };
};

&i2c0 {
    status = "okay";
    /* TODO: They're actually IS31FL3743A */
    /* Macropad has a single controller */
    led_ctrl1: is31fl3733@20 {
        status = "disabled";
        reg = <0x20>;
        compatible = "issi,is31fl3733";
        sdb-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
    };
    /* RGB Keyboard has a second controller */
    led_ctrl2: is31fl3733@23 {
        status = "disabled";
        reg = <0x23>;
        compatible = "issi,is31fl3733";
        sdb-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
    };
};


zephyr_udc0: &usbd {
    status = "okay";
};

&pwm {
    status = "okay";
    /* GPIO25 is connected to channel 4B */
    pinctrl-0 = <&pwm_ch4b_default>;
    pinctrl-names = "default";
    divider-int-0 = <255>;
};

&gpio0 {
    status = "okay";
};

&layout_65_ansi {
    transform = <&default_transform>;
};
