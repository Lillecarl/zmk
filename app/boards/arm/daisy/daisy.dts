/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "daisy-pinctrl.dtsi"
#include <dt-bindings/regulator/npm1300.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Daisy";
	compatible = "flower,daisy";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,bt-mon-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		/* No Bootloader, straight into application */
		// zephyr,code-partition = &slot0_partition;
		/* UF2 Adafruit Bootloader */
		zephyr,code-partition = &code_partition;
		zmk,battery = &npm1300_charger;
	};

	/**
	  * RGB LEDs for charge indication
	  * No pull-downs on PCB, so enable them here.
	  */
	leds {
		compatible = "gpio-leds";
		red_led: led_0 {
		    gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		    label = "Red LED";
		};
		green_led: led_2 {
		    gpios = <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		    label = "Green LED";
		};
		blue_led: led_1 {
		    gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		    label = "Blue LED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		rgb1_red_pwm_led: pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		rgb1_green_pwm_led: pwm_led_1 {
			pwms = <&pwm0 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		rgb1_blue_pwm_led: pwm_led_2 {
			pwms = <&pwm0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
			label = "Pairing Button";
			zephyr,code = <INPUT_BTN_SELECT>;
		};
		/* Looking from the top, left side is low, right side is high */
		/* Left side is assigned "Wireless", right side "USB" */
		protocol_switch: button_1 {
			gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
			label = "Mode Switch";
			zephyr,code = <INPUT_BTN_MODE>;
		};
	};

	/* These aliases are provided for compatibility with samples */
	aliases {
		led0 = &red_led;
		led1 = &green_led;
		led2 = &blue_led;
		pwm-led0 = &rgb1_red_pwm_led;
		pwm-led1 = &rgb1_green_pwm_led;
		pwm-led2 = &rgb1_blue_pwm_led;
		red-pwm-led = &rgb1_red_pwm_led;
		green-pwm-led = &rgb1_green_pwm_led;
		blue-pwm-led = &rgb1_blue_pwm_led;
		bootloader-led0 = &red_led;
		mcuboot-button0 = &button0;
		mcuboot-led0 = &red_led;
		watchdog0 = &wdt0;
	};
};

&adc {
	status = "okay";
};

&uicr {
	// Use 	P0.09 and P0.10 as GPIO for KSO instead of NFC
	nfct-pins-as-gpios;
	// Use P0.18 as nRESET
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart1 {
	status = "disabled";
};

&i2c0 {
	compatible = "nordic,nrf-twi";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	npm1300: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		npm1300_ek_leds: leds {
			compatible = "nordic,npm1300-led";
			nordic,led0-mode = "host";
			nordic,led1-mode = "host";
			nordic,led2-mode = "host";
		};

		npm1300_regulators: regulators {
			compatible = "nordic,npm1300-regulator";
			npm1300_buck1: BUCK1 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};
			npm1300_buck2: BUCK2 {
				/* On boot VOUT2 is 3.3V, configured by 330k OHm resistor to VSET2 */
				/* This power rail drives the RGB LEDs and the nRF52 3.3V rail. */
				/* The lowest voltag ethe nRF52 can run at it 1.7V */
				regulator-min-microvolt = <1700000>;
				regulator-init-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};
		};
		// 1200mAh Li-ion battery
		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";
			/* Charge Limit Voltage 4.2V */
			term-microvolt = <4200000>;
			/* A little lower than charge limit */
			term-warm-microvolt = <4000000>;
			/* 240mA (0.2C) constant current charge */
			current-microamp = <240000>;
			/* Maximum discharge current 1200mA (1C) */
			/* Below 0degC only 240mA (0.2C) are allowed */
			/* Fow now set to 600mA (0.5C)   are allowed */
			dischg-limit-microamp = <600000>;
			/* 1.5A VBUS limit for Type-C without PD negotiation */
			vbus-limit-microamp = <1500000>;
			/* NTC Thermistor */
			thermistor-ohms = <10000>;
			thermistor-beta = <3435>;
			charging-enable;
		};
	};
};

&i2c1 {
	compatible = "nordic,nrf-twi";
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* No external flash ROM or other SPI interfaces */
&qspi {
	status = "disabled";
};
&spi1 {
	status = "disabled";
};
&spi2 {
	status = "disabled";
};
&spi3 {
	status = "disabled";
};

&ieee802154 {
	status = "disabled";
};

