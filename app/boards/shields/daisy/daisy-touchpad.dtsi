/* BLE copy of report-descriptor, without reports 11, 65, 66, 67, re-encoded to fit
 * the 512-byte GATT attribute limit. Every report that remains parses as
 * above; global items that repeat a value already in effect are left out.
 * Written by zephyr-hid-touchpad-module/scripts/ble_report_map.py --drop-page 0xff00;
 * edit report-descriptor and rerun it instead of editing this by hand. */
ble-feature-report-ids = <2 3 5 6 7 10>;
