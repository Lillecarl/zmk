/*
 * Shared touchpad node properties for the Daisy shield. Included inside a
 * `touchpad@2c { ... }` block under whichever I2C bus the target board uses.
 * Board-specific bits (e.g. `dr-gpios`) stay in the per-board overlay.
 */

compatible = "zmk,hid-touchpad";
status = "okay";
reg = <0x2c>;
hid-descriptor-register = <0x20>;
mouse-input-report-id = <1>;
ptp-input-report-id = <4>;
mouse-input-report-size = <8>;
ptp-input-report-size = <29>;
feature-report-ids = <2 3 5 6 7 10 11 65 66 67>;
/* Data bytes per feature report (excl. ID), read off the descriptor: 7 is
 * 1 bit + 7 padding, 66/67 are 3-byte register accessors, 10/65 the 256-byte
 * vendor blobs. Bounds the I2C read a GET clocks. */
feature-report-sizes = <1 1 1 1 1 256 1 256 3 3>;
report-descriptor = [
  05 01          //   Usage Page (Generic Desktop Controls)
  09 02          //   Usage (Mouse)
  A1 01          //   Collection (Application)
  85 01          //     Report ID (0x01)
  09 01          //     Usage (Pointer)
  A1 00          //     Collection (Physical)
  05 09          //       Usage Page (Buttons)
  19 01          //       Usage Minimum (1)
  29 02          //       Usage Maximum (2)
  15 00          //       Logical Minimum (0)
  25 01          //       Logical Maximum (1)
  75 01          //       Report Size (1)
  95 02          //       Report Count (2)
  81 02          //       Input (Var)
  95 06          //       Report Count (6)
  81 03          //       Input (Const, Var)
  05 01          //       Usage Page (Generic Desktop Controls)
  09 30          //       Usage (Direction-X)
  09 31          //       Usage (Direction-Y)
  09 38          //       Usage (Wheel)
  15 81          //       Logical Minimum (-127)
  25 7F          //       Logical Maximum (127)
  75 08          //       Report Size (8)
  95 03          //       Report Count (3)
  81 06          //       Input (Var, Rel)
  05 0C          //       Usage Page (Consumer)
  0A 38 02       //       Usage (AC Pan)
  75 08          //       Report Size (8)
  95 01          //       Report Count (1)
  81 06          //       Input (Var, Rel)
