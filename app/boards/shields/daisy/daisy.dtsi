#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "daisy-layouts.dtsi"

zephyr_udc0: &usbd {
    status = "okay";
};

&arduino_i2c {
    status = "okay";

    touchpad: touchpad@2c {
        compatible = "zmk,hid-touchpad";
        status = "okay";
        reg = <0x2c>;
        dr-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	// xiao
        // dr-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // Instead of parsing the HID report descriptor in firmware
        // We configure the report IDs and report structure here
        // PCT3854
        // mouse-report-id = <2>;
        // inputmode-report-id = <6>;
        // relative-x-off = <4>;
        // relative-x-len = <2>;
        // relative-y-off = <6>;
        // relative-y-len = <2>;
        // button-off = <3>;
        // button-bit = <0>;
        // PCT1036
        mouse-report-id = <1>;
        inputmode-report-id = <6>;
        relative-x-off = <4>;
        relative-x-len = <1>;
        relative-y-off = <5>;
        relative-y-len = <1>;
        button-off = <3>;
        button-bit = <0>;
    };
};

/ {
    touchpad_input: touchpad_input {
        compatible = "zmk,input-listener";
        device = <&touchpad>;
    };
    matrix_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <9>;
        columns = <18>;

        // (row, col)
        map = <
        RC(8, 0) RC(8, 1)
        RC(1,1)  RC(0,2)  RC(3,2)  RC(2,2)  RC(1,2)  RC(4,4)  RC(2,4)  RC(1,4)  RC(2,11) RC(1,9)  RC(0,4)  RC(0,1)  RC(1,5)  RC(2,9)
        RC(3,1)  RC(5,1)  RC(6,4)  RC(6,2)  RC(6,3)  RC(3,3)  RC(3,8)  RC(6,8)  RC(6,5)  RC(6,9)  RC(6,6)  RC(3,6)  RC(0,8)  RC(1,11)
        RC(2,1)  RC(7,5)  RC(7,6)  RC(7,8)  RC(7,9)  RC(2,3)  RC(2,6)  RC(7,1)  RC(7,2) RC(7,3)   RC(7,4)  RC(2,8)  RC(2,5)  RC(3,11)
        RC(6,15) RC(4,1)  RC(3,4)  RC(4,2)  RC(4,3)  RC(1,3)  RC(1,6)  RC(4,6)  RC(4,5)  RC(4,9)  RC(4,8)  RC(1,8)  RC(4,11)
        RC(5,7)           RC(6,1)  RC(5,8)  RC(5,5)  RC(5,9)  RC(0,3)  RC(0,5)  RC(5,11) RC(5,2)  RC(5,3)  RC(5,4)  RC(7,7)
        RC(1,14) RC(0,16) RC(3,0)  RC(6,13)                   RC(5,6)                    RC(0,10) RC(3,14) RC(7,12) RC(7,11) RC(6,12)
                                                                                                                    RC(6,11)
        >;
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <9>;
        columns = <18>;

        direct {
            kscan = <&button_switches_kscan>;
	    // Shift it after the keyboard scan
            row-offset = <8>;
        };

        matrix {
            kscan = <&kscan1>;
        };
    };

    button_switches_kscan: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            // Has external pullup on PCB
            = <&gpio1 13 (GPIO_ACTIVE_LOW)>
	    // Bistable switch with low and high position
            , <&gpio1 14 (GPIO_ACTIVE_LOW)>
            ;
    };

    kscan1: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

	// UART on DK: P0.05, P0.06, P0.07, and P0.08
	// NFC on DK: P0.09 and P0.10
	// Buttons and LEDs on DK: P0.11–P0.16 and P0.24–P0.25
        col-gpios
        = <&gpio0  2 GPIO_ACTIVE_HIGH> // KSO0
        , <&gpio0  3 GPIO_ACTIVE_HIGH> // KSO1
        , <&gpio0  4 GPIO_ACTIVE_HIGH> // KSO2
        , <&gpio0  5 GPIO_ACTIVE_HIGH> // KSO3 UART
        , <&gpio0  7 GPIO_ACTIVE_HIGH> // KSO4 UART
        , <&gpio0  9 GPIO_ACTIVE_HIGH> // KSO5 NFC
        , <&gpio0 10 GPIO_ACTIVE_HIGH> // KSO6 NFC
        , <&gpio0 11 GPIO_ACTIVE_HIGH> // KSO7 Button 1
        , <&gpio0 12 GPIO_ACTIVE_HIGH> // KSO8 Button 2
        , <&gpio0 16 GPIO_ACTIVE_HIGH> // KSO9 LED 4
        , <&gpio0 17 GPIO_ACTIVE_HIGH> // KS10 QSPI CS
        , <&gpio0 19 GPIO_ACTIVE_HIGH> // KS11 QSPI SCLK
        , <&gpio0 20 GPIO_ACTIVE_HIGH> // KS12 QSPI_DIO0
        , <&gpio0 21 GPIO_ACTIVE_HIGH> // KS13 QSPI_DIO1
        , <&gpio0 22 GPIO_ACTIVE_HIGH> // KS14 QSPI_DIO2
        , <&gpio0 23 GPIO_ACTIVE_HIGH> // KS15 QSPI_DIO3
        , <&gpio0 24 GPIO_ACTIVE_HIGH> // KS16 Button 3
        , <&gpio0 25 GPIO_ACTIVE_HIGH> // KS17 Button 4
        ;

        row-gpios
        = <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI0 TRACEDATA[0]
        , <&gpio1  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI1
        , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI2
        , <&gpio1  5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI3
        , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI4
        , <&gpio1  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI5
        , <&gpio1  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI6
        , <&gpio1  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI7 TRACEDATA[3]
        ;
    };

    /**
      * RGB LEDs for charge indication
      * No pull-downs on PCB, so enable them here.
      */
    leds {
        compatible = "gpio-leds";
	// TODO: On nRF52840 DK should leave led 0-2 on the original GPIO assignments
        red_led: led_0 {
            gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };
        green_led: led_1 {
            gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };
        blue_led: led_2 {
            gpios = <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };
    };
};

&matrix_physical_layout {
    kscan = <&kscan0>;
    transform = <&matrix_transform>;
};
