#include <dt-bindings/i2c/i2c.h>

/ {
    chosen {
        zmk,keyboard-hid = &hid_dev_0;
        zephyr,boot-mode = &boot_mode0;
    };

    hid_dev_0: hid_dev_0 {
        compatible = "zephyr,hid-device";
        label = "HID0";
        protocol-code = "keyboard";
        in-report-size = <64>;
        /* 125 us = bInterval 1 at high speed (8 kHz polling). The FS
         * descriptor set clamps to 1 ms (the FS protocol minimum). */
        in-polling-period-us = <125>;
    };

    /* Layout strap GPIOs (read at boot to detect ANSI/ISO/JIS). */
    zephyr,user {
        iso-strap-gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
        ansi-strap-gpios = <&gpio3 1 GPIO_ACTIVE_HIGH>;
    };
};

&gpregret1 {
    status = "okay";

    boot_mode0: boot_mode@0 {
        compatible = "zephyr,retention";
        status = "okay";
        reg = <0x0 0x1>;
    };
};

#include "nrf54lm20a_partitions.dtsi"

/* Pairing button moved to P3.10 on KB EVT (POC uses P1.13 from the shield
 * base in daisy.dtsi). Assumes external pull-up like the POC; add
 * GPIO_PULL_UP here if the EVT PCB lacks one. */
&buttons_input {
    input-gpios = <&gpio3 10 (GPIO_ACTIVE_LOW)>;
};

/* P3.10 is owned by &buttons_input (input-gpio-direct). The board's gpio-keys
 * pairing_button node would double-drive the same pin's interrupt config
 * (EDGE_BOTH/DISABLE vs LEVEL_ACTIVE/DISABLE, last writer wins) and can leave
 * it disabled or GPIO_DISCONNECTED (its PM suspend hook) -> button dead until
 * reboot. Nothing consumes its INPUT_KEY_0 events. factory_hid.c only needs
 * the node's GPIO spec, which still resolves when disabled. */
&pairing_button {
    status = "disabled";
};

/* The mode switch is read directly by protocol_switch.c as a level/SENSE GPIO
 * (which doubles as the System-OFF wake source). Disable the board's gpio-keys
 * child so its EDGE_BOTH interrupt and PM-suspend hook can't fight over the
 * pin, the same double-driver problem as pairing_button above. The label's
 * `gpios` spec still resolves for protocol_switch.c and factory_hid.c. */
&protocol_switch {
    status = "disabled";
};

/* Daisy EVT matrix: KSI0..7 on P0.00..P0.07, KSO0..17 on P1.00..P1.17. */
&matrix_input {
    col-gpios
        = <&gpio1  0 GPIO_ACTIVE_HIGH> // KSO0
        , <&gpio1  1 GPIO_ACTIVE_HIGH> // KSO1
	// Changing to P1.18 in DVT1
        , <&gpio1  2 GPIO_ACTIVE_HIGH> // KSO2
	// Changing to P1.19 in DVT1
        , <&gpio1  3 GPIO_ACTIVE_HIGH> // KSO3
        , <&gpio1  4 GPIO_ACTIVE_HIGH> // KSO4
        , <&gpio1  5 GPIO_ACTIVE_HIGH> // KSO5
        , <&gpio1  6 GPIO_ACTIVE_HIGH> // KSO6
        , <&gpio1  7 GPIO_ACTIVE_HIGH> // KSO7
        , <&gpio1  8 GPIO_ACTIVE_HIGH> // KSO8
        , <&gpio1  9 GPIO_ACTIVE_HIGH> // KSO9
        , <&gpio1 10 GPIO_ACTIVE_HIGH> // KSO10
        , <&gpio1 11 GPIO_ACTIVE_HIGH> // KSO11
        , <&gpio1 12 GPIO_ACTIVE_HIGH> // KSO12
        , <&gpio1 13 GPIO_ACTIVE_HIGH> // KSO13
        , <&gpio1 14 GPIO_ACTIVE_HIGH> // KSO14
        , <&gpio1 15 GPIO_ACTIVE_HIGH> // KSO15
        , <&gpio1 16 GPIO_ACTIVE_HIGH> // KSO16
        , <&gpio1 17 GPIO_ACTIVE_HIGH> // KSO17
        ;

    row-gpios
        = <&gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI0
        , <&gpio0 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI1
        , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI2
        , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI3
        , <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI4
        , <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI5
        , <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI6
        , <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI7
        ;
};

&i2c22 {
    /* 400kHz clock-rate - max what the touchpad supports */
    clock-frequency = <I2C_BITRATE_FAST>;

    touchpad: touchpad@2c {
        #include "../daisy-touchpad.dtsi"
        dr-gpios = <&gpio3 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
