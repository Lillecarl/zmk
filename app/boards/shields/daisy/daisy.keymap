#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define FN    1
#define FNLK  2
#define FM    3

#define ______ &trans
#define TODO   &none
#define PAUSE PAUSE_BREAK

// Special key codes
// | Key Combo | Tap         |
// | FN + 1    | BT Device 1 |
// | FN + 2    | BT Device 2 |
// | FN + 3    | BT Device 3 |
// | FN + U    | USB Output  |
// | FN + B    | BLE Output  |
// | FN + C    | Clear BT    |
// | Win held + E+T chord | Enable Touchpad  |
// | Win held + D+T chord | Disable Touchpad |
/ {
    combos {
        compatible = "zmk,combos";
        // Hold Win, then tap E+T together to enable the touchpad, D+T to
        // disable it. Win itself can't be a combo member (a combo's window
        // starts at its first key, and Win is naturally held long before the
        // letters), so the chord is just the two letters and &tp_pwr checks
        // that a GUI modifier is held -- retyping the letters when it isn't.
        // Key positions: 32 = E, 34 = T, 46 = D.
        combo_tp_enable {
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
            key-positions = <32 34>;
            bindings = <&tp_pwr 1>;
        };
        combo_tp_disable {
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
            key-positions = <46 34>;
            bindings = <&tp_pwr 0>;
        };
    };
    macros {
	// usb_bt_sw: usb_bt_switch {
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     bindings
	// 	= <&led_trig 1>
        //         , <&macro_pause_for_release>
	// 	, <&led_trig 0>
	// 	;
        // };
	emoji: emoji {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // Simulate press WIN+.
            // Works (at least) on Windows
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp DOT>
                , <&macro_release &kp LGUI>
		;
	};
	disp: display_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // Simulate press WIN+P
            // Works (at least) on Windows and GNOME
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp P>
                , <&macro_release &kp LGUI>
		;
	};
    };
    behaviors {
    //     led_trig: led_trigger {
    //         compatible = "zmk,behavior-led-trigger";
    //         #binding-cells = <1>; /* Accepts 1 argument (0 or 1) */
    //     };
        tp_pwr: touchpad_power {
            compatible = "zmk,behavior-touchpad-power";
            #binding-cells = <1>; /* 1 = enable, 0 = disable */
        };
        // Physical pairing button: tap = next BLE profile, hold 1s = clear the
        // active profile's bond. Both go through &pairing (behavior_pairing.c)
        // instead of &bt BT_NXT / BT_CLR so the button is inert in wired mode
        // (protocol switch on USB -> BLE off): otherwise it would switch
        // profiles or wipe a bond on a keyboard that is deliberately cabled.
        pairing: pairing {
            compatible = "zmk,behavior-pairing";
            #binding-cells = <1>; /* 0 = next profile, 1 = clear bond */
        };
        pairing_ht: pairing_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2500>;
            bindings = <&pairing>, <&pairing>;
            display-name = "Mod-Tap";
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                &pairing_ht 1 0
                //&pairing_ht 1 0 &usb_bt_sw
		// &none &none
                // ---------------------------------------------------------------------------------------------------------
                // | ESC  |Mute |Prev |Next  |Prev  |Play  | Next |Search |BrUp   |Displ |Emoji  |Print  | Media |  DEL    |
                // |  ` |  1  |  2  |  3   |  4   |  5   |  6   |  7    |  8    |  9   |   0   |  -    |  =    | BACKSPC   |
                // | TAB |  Q  |  W  |  E   |  R   |  T   |  Y   |  U    |  I    |  O   |   P   |  [    |  ]    |  \       |
                // | CAPS |  A  |  S  |  D   |  F   |  G   |  H   |  J    |  K    |  L   |   ;   |   '   |    Enter        |
                // | SHIFT       |  Z  |  X   |  C   |  V   |  B   |  N   |  M    |  ,    |  .   |   /    | SHIFT          |
                // | CTRL  | FN  | GUI | ALT  | CTRL |        SPACE                | ALT  | CTRL | LEFT   | UP     | RIGHT |
                // |                                                                                      | DOWN   |
                &kp ESC   &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT &kp C_AC_SEARCH &kp C_BRI_UP &disp &emoji &kp PSCRN &kp C_AL_CCC &kp DEL
                &kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp CAPS  &kp A  &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L     &kp SEMI  &kp SQT   &kp RET
                &kp LSHFT        &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp LCTRL &mo FN &kp LGUI &kp LALT                   &kp SPACE                  &kp RALT  &kp RCTRL &kp LEFT  &kp UP    &kp RIGHT
                                                                                                                              &kp DOWN
           >;
        };

        fn_layer {
            display-name = "FN Layer";
            bindings = <
		&trans
                // &bootloader &trans
                // &trans &trans
                // ---------------------------------------------------------------------------------------------------------
                // | FNLK |  F1 |  F2 |  F3  |  F4  |  F5  |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |  F12  |  INS    |
                // |    |     |     |      |      |      |      |       |       |      |       |       |       |           |
                // |     |     |     |      |      |      |      |       |       |      | PAUSE |       |       |          |
                // |      |     |     |      |      |      |      |       | SLCK  |      |       |       |                 |
                // |             |     |      |      |      |      |      |       |       |      |        |                |
                // |       |     |     |      |      |                             |      |      | HOME   | PG UP  | END   |
                // |                                                                                      | PG DN  |
                &tog FNLK &kp F1 &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9    &kp F10   &kp F11   &kp F12   &kp INS
                ______ &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3 ______   ______   ______   ______   ______    ______    ______    ______ &sys_reset
                ______    ______ ______   ______   ______   ______   ______   &out OUT_USB ______   ______   &kp PAUSE ______   ______   ______
                ______    ______ ______   ______   ______   ______   ______   ______   &kp SLCK ______    ______    ______    ______
                ______           ______   ______   &bt BT_CLR ______ &out OUT_BLE ______   ______   ______    ______    ______    ______
                ______    ______ ______   ______                     ______                     ______    ______    &kp HOME  &kp PG_UP &kp END
                                                                                                                              &kp PG_DN
           >;
        };

        fnlock_layer {
            display-name = "FN Lock Layer";
            bindings = <
                &pairing_ht 1 0
                // &pairing_ht 1 0 &usb_bt_sw
		// &none &none
                // ---------------------------------------------------------------------------------------------------------
                // | FNLK |  F1 |  F2 |  F3  |  F4  |  F5  |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |  F12  |  DEL    |
                // |    |     |     |      |      |      |      |       |       |      |       |       |       |           |
                // |     |     |     |      |      |      |      |       |       |      |       |       |       |  \       |
                // |      |     |     |      |      |      |      |       |       |      |       |       |                 |
                // |             |     |      |      |      |      |      |       |       |      |        |                |
                // |       | FN  |     |      |      |                             |      |      |        |        |       |
                // |                                                                                      |        |
                &kp ESC   &kp F1 &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9    &kp F10   &kp F11   &kp F12   &kp INS
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______
                ______           ______   ______   ______   ______   ______    ______  ______   ______    ______    ______    ______
                ______    &mo FM ______   ______                     ______                     ______    ______    ______    ______    ______
                                                                                                                              ______
           >;
        };

        fm_layer {
            display-name = "FM Layer (Temp FN unlock)";
            bindings = <
		&trans
                // &bootloader &trans
                // &trans &trans
                // ---------------------------------------------------------------------------------------------------------
                // | FNLK |Mute |Prev |Next  |Prev  |Play  | Next |Search |BrUp   |Displ |Airplne|Print  | Media |  DEL    |
                // |    |     |     |      |      |      |      |       |       |      |       |       |       |           |
                // |     |     |     |      |      |      |      |       |       |      | PAUSE |       |       |  \       |
                // |      |     |     |      |      |      |      |       |       |      |       |       |                 |
                // |             |     |      |      |      |      |      |       |       |      |        |                |
                // |       |     |     |      |      |                             |      |      | HOME   | PG UP  | END   |
                // |                                                                                      | PG DN  |
                &tog FNLK &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT &kp C_AC_SEARCH &kp C_BRI_UP &disp &emoji &kp PSCRN &kp C_AL_CCC &kp DEL
                ______ &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3 ______   ______   ______   ______   ______    ______    ______    ______ &sys_reset
                ______    ______ ______   ______   ______   ______   ______   &out OUT_USB ______   ______   &kp PAUSE ______   ______   ______
                ______    ______ ______   ______   ______   ______   ______   ______   &kp SLCK ______    ______    ______    ______
                ______           ______   ______   &bt BT_CLR ______ &out OUT_BLE ______   ______   ______    ______    ______    ______
                ______    ______ ______   ______                     ______                     ______    ______    &kp HOME  &kp PG_UP &kp END
                                                                                                                              &kp PG_DN
           >;
        };
    };
};
