#include "framework16.dtsi"

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Default Layer";
            // ┌────┬────┬────┬────┐
            // │Esc │Calc│ =  │ <- │
            // ├────┼────┼────┼────┤
            // │Num │ /  │ *  │ -  │
            // ├────┼────┼────┼────┤
            // │ 7  │ 8  │ 9  │ +  │
            // ├────┼────┼────┤────┤
            // │ 4  │ 5  │ 6  │ +  │
            // ├────┼────┼────┼────┤
            // │ 1  │ 2  │ 3  │Entr│
            // ├────┼────┼────┤────┤
            // │ 0  │ 0  │ .  │Entr│
            // └────┴────┴────┴────┴
            bindings = <
                &kp ESC      &kp K_CALC   &kp KP_EQUAL    &kp BACKSPACE
                &kp KP_NUM   &kp KP_SLASH &kp KP_ASTERISK &kp MINUS
                &kp KP_N7    &kp KP_N8    &kp KP_N9       &kp PLUS
                &kp KP_N4    &kp KP_N5    &kp KP_N6       &kp PLUS
                &kp KP_N1    &kp KP_N2    &kp KP_N3       &kp KP_ENTER
                &kp KP_N0    &kp KP_N0    &kp KP_DOT      &kp KP_ENTER
           >;
        };
    };
};
