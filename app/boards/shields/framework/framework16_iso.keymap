#include "framework16.dtsi"

#include <behaviors.dtsi>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define FN    1
#define FNLK  2
#define FM    3

#define ______ &trans
#define TODO   &none
#define PAUSE PAUSE_BREAK

/ {
    macros {
          air: airplane_button {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // Simulate press WIN+P
            // Works (at least) on Windows and GNOME
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp P>
                , <&macro_release &kp LGUI>
               ;
       };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Default Layer";
            bindings = <
                // ---------------------------------------------------------------------------------------------------------
                // | ESC  |Mute |Prev |Next  |Prev  |Play  | Next |BrDown |BrUp   |Displ |Airplne|Print  | Media |  DEL    |
                // |  ` |  1  |  2  |  3   |  4   |  5   |  6   |  7    |  8    |  9   |   0   |  -    |  =    | BACKSPC   |
                // | TAB |  Q  |  W  |  E   |  R   |  T   |  Y   |  U    |  I    |  O   |   P   |  [    |  ]    |          |
                // | CAPS |  A  |  S  |  D   |  F   |  G   |  H   |  J    |  K    |  L   |   ;   |   '   |    Enter        |
                // | SHIFT |  \  |  Z  |  X   |  C   |  V   |  B   |  N   |  M    |  ,    |  .   |   /    | SHIFT          |
                // | CTRL  | FN  | GUI | ALT  | CTRL |        SPACE                | ALT  | CTRL | LEFT   | UP     | RIGHT |
                // |                                                                                      | DOWN   |
                &kp ESC   &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT &kp C_BRI_DN &kp C_BRI_UP &disp TODO &kp PSCRN &kp C_AL_CCC &kp DEL
                &kp GRAVE &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O     &kp P     &kp LBKT  &kp RBKT
                &kp CAPS  &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L     &kp SEMI  &kp SQT   &kp RET
                &kp LSHFT &kp NUBS &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp LCTRL &mo FN   &kp LGUI &kp LALT                   &kp SPACE                  &kp RALT  &kp RCTRL &kp LEFT  &kp UP    &kp RIGHT
                                                                                                                              &kp DOWN
           >;
        };

        fn_layer {
            display-name = "FN Layer";
            bindings = <
                // ---------------------------------------------------------------------------------------------------------
                // | FNLK |  F1 |  F2 |  F3  |  F4  |  F5  |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |  F12  |  INS    |
                // |    |     |     |      |      |      |      |       |       |      |       |       |       |           |
                // |     |     |     |      |      |      |      |       |       |      |       |       |       |          |
                // |      |     |     |      |      |      |      |       |       |      |       |       |                 |
                // |       |     |     |      |      |      |      |      |       |       |      |        |                |
                // |       |     |     |      |      |                             |      |      | HOME   | PG UP  | END   |
                // |                                                                                      | PG DN  |
                &tog FNLK &kp F1 &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9    &kp F10   &kp F11   &kp F12   &kp INS
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    &kp PAUSE
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   &kp PAUSE ______  ______   ______    ______    ______    ______
                ______    ______ ______   ______                     ______                     ______    ______    &kp HOME  &kp PG_UP &kp END
                                                                                                                              &kp PG_DN
           >;
        };

        fnlock_layer {
            display-name = "FN Lock Layer";
            bindings = <
                // ---------------------------------------------------------------------------------------------------------
                // | FNLK |  F1 |  F2 |  F3  |  F4  |  F5  |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |  F12  |  DEL    |
                // |    |     |     |      |      |      |      |       |       |      |       |       |       |           |
                // |     |     |     |      |      |      |      |       |       |      |       |       |       |          |
                // |      |     |     |      |      |      |      |       |       |      |       |       |                 |
                // |       |     |     |      |      |      |      |      |       |       |      |        |                |
                // |       | FN  |     |      |      |                             |      |      |        |        |       |
                // |                                                                                      |        |
                &kp ESC   &kp F1 &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9    &kp F10   &kp F11   &kp F12   &kp INS
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   ______    ______  ______   ______    ______    ______    ______
                ______    &mo FM ______   ______                     ______                     ______    ______    ______    ______    ______
                                                                                                                              ______
           >;
        };

        fm_layer {
            display-name = "FM Layer (Temp FN unlock)";
            bindings = <
                // ---------------------------------------------------------------------------------------------------------
                // | FNLK |Mute |Prev |Next  |Prev  |Play  | Next |BrDown |BrUp   |Displ |Airplne|Print  | Media |  DEL    |
                // |    |     |     |      |      |      |      |       |       |      |       |       |       |           |
                // |     |     |     |      |      |      |      |       |       |      | PAUSE |       |       |          |
                // |      |     |     |      |      |      |      |       |       |      |       |       |                 |
                // |       |     |     |      |      |      |      |      |       |       |      |        |                |
                // |       |     |     |      |      |                             |      |      | HOME   | PG UP  | END   |
                // |                                                                                      | PG DN  |
                &tog FNLK &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT &kp C_BRI_DN &kp C_BRI_UP &disp TODO &kp PSCRN &kp C_AL_CCC &kp DEL
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    &kp PAUSE ______    ______
                ______    ______ ______   ______   ______   ______   ______   ______   ______   ______    ______    ______    ______
                ______    ______ ______   ______   ______   ______   &kp PAUSE ______  ______   ______    ______    ______    ______
                ______    ______ ______   ______                     ______                     ______    ______    &kp HOME  &kp PG_UP &kp END
                                                                                                                              &kp PG_DN
           >;
        };
    };
};
