menuconfig ZMK_BLE
    bool "BLE (HID over GATT)"
    select BT
    select BT_SMP
    select BT_SMP_SC_PAIR_ONLY
    select BT_SMP_APP_PAIRING_ACCEPT
    select BT_PERIPHERAL
    select BT_DIS
    imply BT_DEVICE_NAME_DYNAMIC
    imply BT_SETTINGS if !ARCH_POSIX
    imply SETTINGS if !ARCH_POSIX
    imply ZMK_BATTERY_REPORTING if !ARCH_POSIX

if ZMK_BLE

config ZMK_BLE_EXPERIMENTAL_CONN
    bool "Experimental BLE connection changes"
    help
      Enables settings that are planned to be default in future versions of ZMK
      to improve connection stability.

config ZMK_BLE_EXPERIMENTAL_SEC
    bool "Experimental BLE security changes"
    imply BT_SMP_ALLOW_UNAUTH_OVERWRITE
    help
      Enables security settings that are planned to be officially supported in the future.

config ZMK_BLE_EXPERIMENTAL_FEATURES
    bool "Experimental BLE connection and security settings/features"
    select ZMK_BLE_EXPERIMENTAL_CONN
    select ZMK_BLE_EXPERIMENTAL_SEC
    help
      Enables experimental connection changes and security features.

config ZMK_BLE_SINGLE_CONNECTION
    bool "Only stay connected to one host at a time"
    help
      Restrict the keyboard to a single active host connection. Selecting another
      profile disconnects the host of the previously selected profile, and hosts
      bonded to a non-selected profile are dropped if they try to connect.

config ZMK_BLE_PASSKEY_ENTRY
    bool "Require passkey entry on the keyboard to complete pairing"
    select RING_BUFFER

config ZMK_BLE_STEALTH_ADV
    bool "Use non-discoverable advertising for bonded profiles"
    default y
    help
      When the active profile is already bonded but not connected, advertise
      connectable undirected (ADV_IND) but GAP non-discoverable: the Flags AD
      has both discoverable-mode bits clear and the payload carries no name,
      appearance or service UUIDs. Compliant pairing UIs (Windows, macOS, iOS,
      Android, bluetoothd) are required by GAP's discovery procedures to hide
      such adverts, so the keyboard only shows up in scan menus while the
      active profile is unpaired -- while the bonded host, which reconnects by
      (IRK-resolved) address and never looks at the payload, still connects.

      Unlike directed advertising this is Apple-compatible (their accessory
      guidelines forbid ADV_DIRECT_IND). It does not gate who may *connect*;
      a taken profile still rejects pairing at the SMP layer and tears down
      links that cannot start encryption.

      Set to n to restore the old behavior (always discoverable advertising)
      if a host turns out not to reconnect to non-discoverable advertisements.

config ZMK_BLE_STEALTH_ADV_NAME
    bool "Keep the device name in non-discoverable advertisements"
    depends on ZMK_BLE_STEALTH_ADV
    help
      Include the Local Name AD in the non-discoverable reconnect
      advertisement. Bonded hosts do not need it (reconnection is
      address-based), and it makes the packets identifiable to anyone running
      a raw scanner, but Nordic's nRF Desktop ships name-in-stealth "for
      backwards compatibility" -- enable this as the proven fallback if some
      host refuses to reconnect to a nameless advertisement.

config ZMK_BLE_STEALTH_ADV_BURST
    bool "Open reconnect advertising with a fast burst"
    depends on ZMK_BLE_STEALTH_ADV
    default y
    help
      Start every fresh reconnect advertisement (boot with a bond, disconnect,
      profile switch, adv re-enable, key activity while disconnected) at the
      minimum advertising interval (20 ms) for a short window before settling
      into the slow 100-150 ms cadence. A scanning host answers the first
      packet it hears, so reconnection completes in tens of milliseconds
      instead of several hundred.

if ZMK_BLE_STEALTH_ADV_BURST

config ZMK_BLE_STEALTH_ADV_BURST_MS
    int "Fast burst window length in ms"
    default 5000

config ZMK_BLE_STEALTH_ADV_BURST_COOLDOWN_MS
    int "Minimum ms between activity-kicked bursts"
    default 30000
    help
      Key activity while the active profile is bonded but disconnected kicks a
      fresh burst window. This cooldown bounds the radio time spent bursting
      when the user keeps typing at a host that is not there.

endif # ZMK_BLE_STEALTH_ADV_BURST

config BT_SMP_ALLOW_UNAUTH_OVERWRITE
    imply ZMK_BLE_PASSKEY_ENTRY

config BT_CTLR_PHY_2M
    default n if ZMK_BLE_EXPERIMENTAL_CONN

config ZMK_BLE_THREAD_STACK_SIZE
    int "BLE notify thread stack size"
    default 768

config ZMK_BLE_THREAD_PRIORITY
    int "BLE notify thread priority"
    default 5

config ZMK_BLE_KEYBOARD_REPORT_QUEUE_SIZE
    int "Max number of keyboard HID reports to queue for sending over BLE"
    default 20

config ZMK_BLE_CONSUMER_REPORT_QUEUE_SIZE
    int "Max number of consumer HID reports to queue for sending over BLE"
    default 5

config ZMK_BLE_MOUSE_REPORT_QUEUE_SIZE
    int "Max number of mouse HID reports to queue for sending over BLE"
    default 20

config ZMK_BLE_TELEPHONY_REPORT_QUEUE_SIZE
    int "Max number of telephony HID reports to queue for sending over BLE"
    default 5

config ZMK_BLE_CLEAR_BONDS_ON_START
    bool "Configuration that clears all bond information from the keyboard on startup."

# HID GATT notifications sent this way are *not* picked up by Linux, and possibly others.
config BT_GATT_NOTIFY_MULTIPLE
    default n

config BT_GATT_AUTO_SEC_REQ
    default (ZMK_SPLIT_BLE && !ZMK_SPLIT_ROLE_CENTRAL)

config BT_PERIPHERAL_PREF_MIN_INT
    default 6

config BT_PERIPHERAL_PREF_MAX_INT
    default 12

config BT_PERIPHERAL_PREF_LATENCY
    default 30

config BT_PERIPHERAL_PREF_TIMEOUT
    default 400

# The device name should be 16 characters or less so it fits within the
# advertising data.
config BT_DEVICE_NAME_MAX
    default 16

endif # ZMK_BLE

